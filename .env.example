# Copy to .env and fill from the password manager. Never commit .env.
# One key per environment: local, staging and production each get their own values.

# Node runtime mode: development | production
NODE_ENV=
# Which deployment this is: local | staging | production
APP_ENV=

# Telegram bot token from @BotFather (separate bot per environment)
TELEGRAM_BOT_TOKEN=
# Webhook secret_token header value; generate with `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_...). Server only, bypasses RLS, never in the Mini App
SUPABASE_SECRET_KEY=
# Postgres via Supavisor session pooler (port 5432, IPv4): postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
# Percent-encode special characters in the password (the Supabase CLI requires it)
DATABASE_URL=
# Path to Supabase's CA certificate for verify-full TLS. Leave empty locally;
# Railway sets /app/certs/supabase-ca.crt
DATABASE_CA_CERT_PATH=

# Public base URL for the Telegram webhook. Optional: on Railway it is derived from
# RAILWAY_PUBLIC_DOMAIN. Ignored when APP_ENV=local
PUBLIC_URL=

# Anthropic API key (local key gets a low spend limit). Required by the worker on staging
# and production; locally optional (cards then fall back to the raw message)
ANTHROPIC_API_KEY=
# Model for owner cards (worker). Default claude-haiku-4-5
CARD_MODEL=
# Soniox speech-to-text for voice notes (worker). Optional: without it voice notes reach the
# owner as the original audio
SONIOX_API_KEY=
# Jev decision engine key; leave empty until access is granted
JEV_API_KEY=

# Sentry DSN for error reporting; empty disables Sentry
SENTRY_DSN=
