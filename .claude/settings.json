{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./.env.test)",
      "Read(./.env.keys)",
      "Read(./.env.vault)",
      "Read(./secrets/**)"
    ]
  }
}
